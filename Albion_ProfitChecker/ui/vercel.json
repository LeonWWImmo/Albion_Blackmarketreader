{
  "redirects": [
    {
      "source": "/premium-plus",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/premium-plus/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Crafting%20Calculator",
      "destination": "/crafting-calculator",
      "permanent": true
    },
    {
      "source": "/dashboard.html",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/community/index.html",
      "destination": "/community",
      "permanent": true
    },
    {
      "source": "/legal/index.html",
      "destination": "/legal",
      "permanent": true
    },
    {
      "source": "/Blackmarket-Crafter",
      "destination": "/bm-crafter",
      "permanent": true
    },
    {
      "source": "/Blackmarket-Crafter/index.html",
      "destination": "/bm-crafter",
      "permanent": true
    },
    {
      "source": "/crafting-calculator/index.html",
      "destination": "/crafting-calculator",
      "permanent": true
    },
    {
      "source": "/refining-calculator/index.html",
      "destination": "/refining-calculator",
      "permanent": true
    },
    {
      "source": "/Refining%20Calculator",
      "destination": "/refining-calculator",
      "permanent": true
    },
    {
      "source": "/Refining%20Calculator/index.html",
      "destination": "/refining-calculator",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/discord-daily",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/guild/sync",
      "schedule": "30 3 * * *"
    },
    { "path": "/api/cron/market-live", "schedule": "7,37 * * * *" },
    { "path": "/api/cron/guild-zvz", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/gold-alerts", "schedule": "41 * * * *" },
    { "path": "/api/cron/gold-names", "schedule": "11 0,8,16 * * *" },
    { "path": "/api/cron/data-sync-eu-1", "schedule": "0 11 * * *" },
    { "path": "/api/cron/data-sync-eu-2", "schedule": "0 16 * * *" },
    { "path": "/api/cron/data-sync-1", "schedule": "0 21 * * *" },
    { "path": "/api/cron/data-sync-2", "schedule": "0 2 * * *" },
    { "path": "/api/cron/food-potion-prices", "schedule": "0 4 * * *" },
    { "path": "/api/cron/merge-results", "schedule": "0 8 * * *" },
    { "path": "/api/cron/daily-avg-history", "schedule": "30 8 * * *" },
    { "path": "/api/cron/merge-results-eu", "schedule": "0 9 * * *" },
    { "path": "/api/cron/crafting-results-prices", "schedule": "5 10 * * *" },
    { "path": "/api/cron/materials-prices-by-city", "schedule": "35 10 * * *" },
    { "path": "/api/cron/journal-prices", "schedule": "45 10 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/aodp/:endpoint",
      "destination": "/api/aodp?endpoint=:endpoint"
    },
    {
      "source": "/prices/:slug",
      "destination": "/api/seo/price-page?slug=:slug"
    },
    {
      "source": "/api/guild/:action",
      "destination": "/api/guild?action=:action"
    },
    {
      "source": "/api/market/:action",
      "destination": "/api/market?action=:action"
    },
    {
      "source": "/api/billing/:action",
      "destination": "/api/billing?action=:action"
    },
    {
      "source": "/api/cron/:job",
      "destination": "/api/cron?job=:job"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/results(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/avg-profit-history.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/items-categorized-crafting.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/picture/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, s-maxage=2592000, immutable"
        }
      ]
    },
    {
      "source": "/itemicons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, s-maxage=2592000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; img-src 'self' data: blob: https://render.albiononline.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://va.vercel-scripts.com https://vitals.vercel-insights.com"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/guild.js": {
      "maxDuration": 60
    }
  }
}
